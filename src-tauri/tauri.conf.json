{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "随心写作",
  "version": "0.1.0",
  "identifier": "com.aiwriter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "随心写作",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "随心写作",
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "写作与改稿，AI 只提建议，由你拍板",
    "longDescription": "块级 AI 协作写作：选中一段或一句，让 AI 润色、精简、扩写或续写；所有修改先以对照形式呈现，逐处确认后才写入，并记入版本历史。本地优先，文稿自动保存。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
