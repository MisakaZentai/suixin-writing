{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Writer",
  "version": "0.1.0",
  "identifier": "com.aiwriter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Writer — 块级协作写作",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "AI Writer",
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "块级 AI 协作写作",
    "longDescription": "导入 → 拆块 → 点选块 → 改（手动 / 提意见 / AI 重写）→ 内联 diff 确认 → 导出。作者主权：AI 永不直接改写正文。"
  }
}
