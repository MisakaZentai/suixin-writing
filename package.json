{
  "name": "suixin-writing",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "块级 AI 协作写作桌面应用（Tauri + React + TypeScript）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri",
    "build:cli": "node scripts/build-cli.mjs",
    "suixin": "node dist-cli/suixin.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.1",
    "diff-match-patch": "^1.0.5",
    "immer": "^10.1.1",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  },
  "bin": {
    "suixin": "dist-cli/suixin.mjs"
  }
}
